    { "name": "search", "type": "rag_query", "description": "Instant semantic search across all indexed data records", "icon": "bi-search" },
    { "name": "update_config", "type": "config", "description": "Update a configuration value by path (AI-accessible)", "icon": "bi-gear" },
    { "name": "get_config", "type": "config", "description": "Get a configuration value by path (AI-accessible)", "icon": "bi-info-circle" },
    { "name": "add_character", "type": "config", "description": "Add a new character/persona to the system (AI-accessible)", "icon": "bi-person-plus" },
    { "name": "add_business", "type": "config", "description": "Add a new business/workspace to the system (AI-accessible)", "icon": "bi-building-add" },
    { "name": "create_tool", "type": "system", "description": "Create and register a new tool dynamically (AI-accessible)", "icon": "bi-tools" },
    { "name": "rollback_config", "type": "config", "description": "Rollback configuration to a previous state (AI-accessible)", "icon": "bi-arrow-counterclockwise" },
    { "name": "list_tools", "type": "system", "description": "List all available tools with their schemas (AI-accessible)", "icon": "bi-list-check" },
    { "name": "execute_chain", "type": "system", "description": "Execute a chain of tools in sequence (AI-accessible)", "icon": "bi-link" },
    { "name": "delegate_to_agent", "type": "agent", "description": "Delegate a task to another specialized agent (AI-accessible)", "icon": "bi-person-workspace" },
    { "name": "ask_agent", "type": "agent", "description": "Ask a specific agent a question for collaboration (AI-accessible)", "icon": "bi-chat-quote" },
    { "name": "list_agents", "type": "agent", "description": "List all available agents and their specializations (AI-accessible)", "icon": "bi-people" },
    { "name": "route_to_specialist", "type": "agent", "description": "Automatically route query to the best specialist agent (AI-accessible)", "icon": "bi-signpost-split" },
    { "name": "web_search", "type": "web", "description": "Search the internet for information (AI-accessible)", "icon": "bi-globe" },
    { "name": "google_calendar_list", "type": "google", "description": "List Google Calendar events (AI-accessible)", "icon": "bi-calendar-event" },
    { "name": "google_drive_list", "type": "google", "description": "List Google Drive files (AI-accessible)", "icon": "bi-google" },
    { "name": "google_sheets_read", "type": "google", "description": "Read Google Sheets data (AI-accessible)", "icon": "bi-table" },
    { "name": "change_character_name", "type": "config", "description": "Change the current character's name (AI-accessible)", "icon": "bi-person-badge" }
