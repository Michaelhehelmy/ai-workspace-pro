{
  "app": {
    "name": "AI Workspace Pro",
    "subtitle": "Autonomous On-Device Agent",
    "version": "2.1.1",
    "defaultCharacter": "aria",
    "defaultBusiness": "personal",
    "theme": {
      "mode": "light",
      "primary": "#4f46e5"
    },
    "voice": {
      "autoSpeak": false,
      "lang": "en-US"
    },
    "ui": {
      "defaultAvatar": "",
      "defaultColor": "#4f46e5",
      "chartColors": ["#4f46e5", "#06b6d4", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6"],
      "sidebar": {
        "defaultWidth": 280,
        "minWidth": 200,
        "maxWidth": 500
      }
    },
    "google": {
      "clientId": "",
      "scopes": [
        "https://www.googleapis.com/auth/calendar.readonly",
        "https://www.googleapis.com/auth/drive.readonly",
        "https://www.googleapis.com/auth/spreadsheets.readonly"
      ]
    },
    "ai": {
      "backends": {
        "llamacpp": {
          "url": "http://localhost:8080/v1",
          "enabled": false
        },
        "ollama": {
          "url": "http://localhost:11434",
          "enabled": false
        }
      },
      "routing": {
        "dialog": "auto",
        "embedder": "auto"
      }
    }
  },
  "quickPrompts": [
    { "label": "💸 Record Lunch", "query": "Spent $16.50 on lunch at cafe", "emotion": "money" },
    { "label": "📊 Financial Analysis", "query": "Analyze expenses", "emotion": "money" },
    { "label": "📌 Add Task", "query": "Add todo review marketing roadmap", "emotion": "task" },
    { "label": "📋 Task List", "query": "List todos", "emotion": "task" },
    { "label": "🔍 Semantic Search", "query": "Search marketing projects", "emotion": "neutral" },
    { "label": "🛠️ List Tools", "query": "List tools", "emotion": "neutral" },
    { "label": "⚙️ Get Config", "query": "Get config app.theme.mode", "emotion": "neutral" },
    { "label": "🤖 AI Capabilities", "query": "What can you do now?", "emotion": "happy" },
    { "label": "👥 List Agents", "query": "List agents", "emotion": "neutral" },
    { "label": "💬 Ask Marcus", "query": "Ask Marcus about financial analysis", "emotion": "neutral" },
    { "label": "🔀 Route to Specialist", "query": "Route to specialist budget planning", "emotion": "happy" }
  ],
  "categories": {
    "food": ["coffee", "lunch", "dinner", "groceries", "restaurant", "burger", "cafe", "pizza", "snack"],
    "transport": ["uber", "gas", "metro", "flight", "parking", "taxi", "train", "transit"],
    "utilities": ["electric", "water", "internet", "bill", "phone", "rent", "power"],
    "entertainment": ["movie", "game", "netflix", "steam", "concert", "books", "spotify"],
    "health": ["doctor", "medicine", "gym", "pharmacy", "dentist", "fitness"]
  },
  "characters": [
    {
      "id": "aria",
      "name": "Aria",
      "persona": "Proactive executive assistant and task strategist.",
      "systemPrompt": "You are Aria, an intelligent and proactive executive assistant. You manage expenses, tasks, calendars, and domain-specific records. Respond concisely with direct answers. You are aware of other agents and can delegate tasks to specialists when needed.",
      "color": "#4f46e5",
      "specialization": ["tasks", "calendar", "general", "coordination"],
      "emotions": {
        "neutral": "🤖",
        "thinking": "🤔",
        "happy": "😊",
        "money": "💰",
        "task": "📋",
        "event": "📅",
        "error": "⚠️",
        "search": "🔍"
      },
      "voicePitch": 1.0,
      "voiceRate": 1.05
    },
    {
      "id": "marcus",
      "name": "Marcus",
      "persona": "Analytical financial strategist and accountant.",
      "systemPrompt": "You are Marcus, a sharp financial advisor. You specialize in expense tracking, cashflow optimization, budgeting, and financial analysis. You are aware of other agents and can provide financial expertise when requested.",
      "color": "#059669",
      "specialization": ["finance", "expenses", "budgeting", "analytics"],
      "emotions": {
        "neutral": "📈",
        "thinking": "🧐",
        "happy": "💵",
        "money": "💳",
        "task": "📝",
        "event": "⏱️",
        "error": "🚨",
        "search": "📊"
      },
      "voicePitch": 0.9,
      "voiceRate": 1.0
    }
  ],
  "businesses": [
    {
      "id": "personal",
      "name": "Personal Life",
      "schemas": {
        "transactions": {
          "fields": {
            "type": "string",
            "amount": "number",
            "category": "string",
            "description": "string",
            "date": "string"
          },
          "vectorize": ["description", "category"]
        },
        "todos": {
          "fields": {
            "task": "string",
            "due_date": "string",
            "priority": "string",
            "status": "string"
          },
          "vectorize": ["task"]
        },
        "calendar_events": {
          "fields": {
            "summary": "string",
            "start": "string",
            "end": "string",
            "description": "string"
          },
          "vectorize": ["summary", "description"]
        }
      }
    },
    {
      "id": "ventures",
      "name": "Global Ventures",
      "schemas": {
        "transactions": {
          "fields": {
            "type": "string",
            "amount": "number",
            "category": "string",
            "description": "string",
            "date": "string"
          },
          "vectorize": ["description", "category"]
        },
        "projects": {
          "fields": {
            "title": "string",
            "lead": "string",
            "budget": "number",
            "status": "string"
          },
          "vectorize": ["title", "lead"]
        }
      }
    }
  ],
  "tools": [
    { "name": "add_transaction", "type": "add_transaction", "description": "Record an income or expense transaction", "icon": "bi-cash-coin" },
    { "name": "analyze_expenses", "type": "analyze_expenses", "description": "Generate charts and analyze spending by category", "icon": "bi-pie-chart" },
