    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.0",
    "@huggingface/transformers": "3.3.3",
    "c8": "^12.0.0",
    "onnxruntime-node": "1.20.1",
    "wrangler": "^4.20.0"
  }
}
