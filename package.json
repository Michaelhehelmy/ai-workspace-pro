{
  "name": "ai-workspace-pro",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Autonomous on-device agent workspace running small real Hugging Face models (embeddings, intent, NER, dialog).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.js",
